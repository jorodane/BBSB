  patterns:
  - id: counted-flick
    description: 앞다리로 바닥을 두 번 찍어 하나·둘 Call을 보낸 뒤, 다음 박자에 팽팽한 실을 발목 높이로 당긴다.
    cueLeadTicks: 8
    responseTicks: 4
    restTicks: 4
    cueAlignmentTicks: 4
    silentWaitTicks: 0
    participationChance: 0.18
    displayName: 둘 세고 당기기
    calls:
    - offsetTick: 0
